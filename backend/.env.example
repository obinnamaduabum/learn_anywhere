# Export variables; Quarkus also supports a local .env file.
APP_HOST=0.0.0.0
APP_PORT=8084
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/learning
POSTGRES_USER=learning
POSTGRES_PASSWORD=local-dev-only
DB_MAX_OPEN=10
MIGRATE_AT_START=false
SWAGGER_ENABLED=false
# Required for staff draft import/review/approval. Use a strong random value.
ADMIN_TOKEN=

# Optional learner explanations via Groq; keep this key on the backend.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
